# ============ 路径（AutoDL 默认放在数据盘 /root/autodl-tmp） ============
BASE_DIR=/root/autodl-tmp
DATA_DIR=/root/autodl-tmp/data/studio
PORT=6006

# ============ 文字模型（全流程统一一个） ============
# local = 本机 llama.cpp（占用显存，出图/出视频前会自动停掉）
# api   = 任意 OpenAI 兼容接口（DeepSeek / 阿里百炼 等），不占显存
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=none
LLM_MODEL=qwen3.6-35b-a3b
LLM_GGUF=/root/autodl-tmp/models/llm/Qwen_Qwen3.6-35B-A3B-Q4_K_M.gguf
LLM_CTX=32768
LLAMA_SERVER_BIN=/root/autodl-tmp/llama.cpp/build/bin/llama-server

# ============ ComfyUI ============
COMFYUI_DIR=/root/autodl-tmp/ComfyUI
COMFYUI_URL=http://127.0.0.1:8188

# 图片：Qwen-Image 2.1（文生图 + 多图参考，一个模型搞定）
IMAGE_UNET=qwen_image_2.1_turbo_int8_convrot.safetensors
IMAGE_CLIP=qwen3vl_8b_int8_convrot.safetensors
IMAGE_VAE=qwen_image_2.1_vae_bf16.safetensors

# 视频：MiniMax H3（画面 + 对白/音效/配乐 一次生成）
VIDEO_I2V_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors
VIDEO_R2V_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
VIDEO_CLIP=qwen3vl_32b_minimax_h3_int8_convrot.safetensors
VIDEO_VAE=minimax_h3_video_vae_int8_convrot.safetensors
VIDEO_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
VIDEO_I2V_TURBO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
VIDEO_R2V_TURBO_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors

# ============ FaceFusion ============
FACEFUSION_DIR=/root/autodl-tmp/facefusion
FACEFUSION_PYTHON=/root/autodl-tmp/envs/facefusion/bin/python

# ============ 访问密码 ============
# 端口开放到公网时务必设置；05_app.sh 会自动生成一个随机密码。留空 = 不需要密码
ACCESS_PASSWORD=

# ============ 自动质检（FaceFusion 环境里运行，CPU，几秒钟） ============
# 检查：视频里冒出的乱码字幕/文字、人物脸和定妆照是否一致（只对写实画风）；不合格自动换种子重抽
QA_ENABLED=true
QA_VIDEO_RETRY=1
QA_KEYFRAME_RETRY=1
QA_FACE_THRESHOLD=0.3

# ============ 固定音色配音 + 对口型（bash deploy/06_voice.sh 安装） ============
# TTS_DIR=/root/autodl-tmp/index-tts
# TTS_PYTHON=/root/autodl-tmp/envs/tts/bin/python
# LIPSYNC_DIR=/root/autodl-tmp/LatentSync
# LIPSYNC_PYTHON=/root/autodl-tmp/envs/lipsync/bin/python
LIPSYNC_STEPS=20

# ==================== 统一平台 ====================
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=6008
DATA_DIR=/root/autodl-tmp/ai-studio/data/platform-v2
MAX_UPLOAD_MB=2000
TASK_WORKERS=1

# ==================== Gemma / llama.cpp ====================
GEMMA_BASE_URL=http://127.0.0.1:6006/v1
GEMMA_MODEL=gemma
GEMMA_TIMEOUT_SECONDS=180

# ==================== ComfyUI 图片生成 ====================
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=/root/autodl-tmp/ai-studio/platform-v2/workflows/sdxl_api.json
COMFYUI_CHECKPOINT=lustifySDXLNSFWSFW_v20.safetensors
COMFYUI_START_COMMAND=bash /root/autodl-tmp/ai-studio/start_comfy.sh
COMFYUI_STOP_COMMAND=bash /root/autodl-tmp/ai-studio/stop_comfy.sh
COMFYUI_START_TIMEOUT_SECONDS=180
COMFYUI_STOP_TIMEOUT_SECONDS=60
COMFYUI_TASK_TIMEOUT_SECONDS=1200

# ==================== FaceFusion 3.8.0 ====================
FACEFUSION_DIR=/root/autodl-tmp/ai-studio/facefusion
FACEFUSION_PYTHON=/root/autodl-tmp/envs/ai-studio-facefusion/bin/python
FACEFUSION_TASK_TIMEOUT_SECONDS=1800
FACEFUSION_STOP_COMMAND=pkill -f '[f]acefusion.py headless-run' || true

# ==================== GPU 切换 ====================
# ComfyUI 与 FaceFusion 为互斥 GPU 工作区；Gemma 默认不参与切换。
GPU_DEVICE_ID=0
GPU_MIN_FREE_MB=8000
GPU_RELEASE_STABLE_SAMPLES=3
GPU_RELEASE_POLL_SECONDS=2
GPU_DRAIN_TIMEOUT_SECONDS=1800
GPU_SWITCH_TIMEOUT_SECONDS=660
LLM_STARTUP_TIMEOUT_MARGIN_SECONDS=60

# LLM startup must finish before the outer GPU workspace timeout.
GEMMA_START_TIMEOUT_SECONDS=600
STAGE04_REQUIRED_MODEL_ID=qwen3-32b-abliterated
STAGE04_REQUIRED_MODEL_ALIAS=qwen3-32b
